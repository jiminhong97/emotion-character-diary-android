<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mainBackgroundContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 배경 이미지 (현재 배경) -->
    <ImageView
        android:id="@+id/bgCurrent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_default" />

    <!-- 배경 이미지 (다음 배경 ; 페이드 전환에 사용) -->
    <ImageView
        android:id="@+id/bgNext"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:alpha="0" />

    <!-- UI 전체 -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- 캐릭터 -->
            <ImageView
                android:id="@+id/imgEmotion"
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:layout_marginTop="40dp"
                android:src="@drawable/emotion_happy"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter" />

            <!-- 감정 선택 라디오 그룹 -->
            <RadioGroup
                android:id="@+id/rgMood"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp">

                <RadioButton android:id="@+id/rbHappy" android:text="행복" />
                <RadioButton android:id="@+id/rbSad" android:text="슬픔" />
                <RadioButton android:id="@+id/rbTired" android:text="피곤" />
                <RadioButton android:id="@+id/rbAngry" android:text="화남" />

            </RadioGroup>

            <!-- 에너지 RatingBar -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="오늘의 기분 에너지"
                android:layout_marginTop="20dp" />

            <RatingBar
                android:id="@+id/ratingBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:numStars="5"
                android:stepSize="1" />

            <!-- 저장 버튼 -->
            <Button
                android:id="@+id/btnSave"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="오늘의 감정 저장하기"
                android:layout_marginTop="30dp" />
        </LinearLayout>
    </ScrollView>

</FrameLayout>
